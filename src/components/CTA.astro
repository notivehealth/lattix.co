---
import Button from './Button.astro';
interface Props {
  title?: string;
  lede?: string;
}
const {
  title = 'Get started today',
  lede = 'Talk with our interoperability team about labs, imaging, clinical records, and nationwide exchange.',
} = Astro.props;
---

<section class="relative overflow-hidden bg-ink px-5 py-24 text-cream sm:px-8">
  <div class="pointer-events-none absolute inset-0 bg-lattice-dots opacity-40"></div>
  <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-signal/10 blur-3xl"></div>
  <div class="relative mx-auto max-w-3xl text-center">
    <h2 class="font-serif text-4xl tracking-tight text-balance sm:text-5xl">{title}</h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-mist text-pretty">{lede}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href="/contact" variant="primary" size="lg">Talk to an expert</Button>
      <Button href="/developers" variant="secondary" size="lg">View APIs</Button>
    </div>
  </div>
</section>
