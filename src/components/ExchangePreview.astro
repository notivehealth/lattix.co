---
const rows = [
  { k: 'Order', v: 'HbA1c · CMP · Lipid panel' },
  { k: 'Destination', v: 'Regional clinical laboratory' },
  { k: 'Transport', v: 'HL7 ORM^O01 → FHIR ServiceRequest' },
  { k: 'Result', v: 'DiagnosticReport · final' },
  { k: 'Observations', v: 'HbA1c 6.4% · CMP within range' },
  { k: 'Filed', v: 'EHR chart payload · provenance intact' },
];
---

<div class="overflow-hidden rounded-2xl border border-white/10 bg-ink-2 shadow-2xl">
  <div class="flex items-center justify-between border-b border-white/8 px-5 py-3">
    <div class="flex items-center gap-2">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff6b6b]/80"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-gold/80"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-signal/80"></span>
    </div>
    <p class="font-mono text-[11px] tracking-wide text-mist">POST /fhir/ServiceRequest</p>
  </div>
  <div class="grid gap-0 md:grid-cols-[200px_1fr]">
    <aside class="hidden border-r border-white/8 p-4 text-sm text-mist md:block">
      <p class="mb-3 text-[0.65rem] uppercase tracking-[0.16em] text-gold">Exchange</p>
      <dl class="space-y-3">
        <div>
          <dt class="text-[0.65rem] uppercase tracking-[0.14em] text-mist/70">Patient</dt>
          <dd class="mt-0.5 text-cream">Elena Voss</dd>
        </div>
        <div>
          <dt class="text-[0.65rem] uppercase tracking-[0.14em] text-mist/70">DOB</dt>
          <dd class="mt-0.5 font-mono text-xs text-cream/90">1971-04-12</dd>
        </div>
        <div>
          <dt class="text-[0.65rem] uppercase tracking-[0.14em] text-mist/70">Purpose</dt>
          <dd class="mt-0.5 text-cream">TREATMENT</dd>
        </div>
        <div>
          <dt class="text-[0.65rem] uppercase tracking-[0.14em] text-mist/70">Status</dt>
          <dd class="mt-0.5 text-signal">Resulted</dd>
        </div>
      </dl>
    </aside>
    <div class="p-5 sm:p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-[0.65rem] uppercase tracking-[0.16em] text-gold">Diagnostic loop</p>
          <h3 class="mt-1 font-serif text-2xl text-cream">Order in. Result filed.</h3>
          <p class="mt-1 font-mono text-xs text-mist">sr-44190 · 3 tests · 1 origin</p>
        </div>
        <span class="rounded-full bg-signal/15 px-3 py-1 text-xs font-medium text-signal">Structured</span>
      </div>
      <dl class="mt-6 divide-y divide-white/8">
        {
          rows.map((s) => (
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between">
              <dt class="text-xs uppercase tracking-[0.14em] text-mist">{s.k}</dt>
              <dd class="text-sm text-cream/90 sm:text-right">{s.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</div>
