---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { href, variant = 'primary', size = 'md', class: className = '' } = Astro.props;

const variants = {
  primary:
    'bg-signal text-ink hover:bg-white shadow-[0_0_0_1px_rgb(62_224_184_/_0.4),0_8px_24px_-12px_rgb(62_224_184_/_0.7)]',
  secondary:
    'bg-transparent text-cream border border-white/15 hover:border-signal/60 hover:text-signal',
  ghost: 'bg-transparent text-ink border border-ink/12 hover:border-ink/40 hover:bg-ink/4',
  dark: 'bg-ink text-cream hover:bg-ink-3 shadow-[0_8px_24px_-12px_rgb(8_12_20_/_0.6)]',
};
const sizes = {
  sm: 'h-9 px-3.5 text-sm',
  md: 'h-11 px-5 text-[0.95rem]',
  lg: 'h-12 px-6 text-base',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full font-medium tracking-tight transition duration-200',
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <slot />
</a>
