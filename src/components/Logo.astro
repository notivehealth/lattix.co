---
interface Props {
  class?: string;
  wordmark?: boolean;
  compact?: boolean;
}
const { class: className = '', wordmark = true, compact = false } = Astro.props;
---

<a href="/" class:list={['group inline-flex items-center gap-2.5', className]} aria-label="Lattix home">
  <svg
    viewBox="0 0 32 32"
    class:list={['shrink-0', compact ? 'h-7 w-7' : 'h-8 w-8']}
    fill="none"
    aria-hidden="true"
  >
    <g class="stroke-current" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 8.2 22.9 12.2 22.9 19.8 16 23.8 9.1 19.8 9.1 12.2Z" />
      <path d="M16 8.2v7.8M22.9 12.2 16 16M22.9 19.8 16 16M16 23.8v-7.8M9.1 19.8 16 16M9.1 12.2 16 16" />
    </g>
    <circle cx="16" cy="16" r="2.05" class="fill-signal" />
    <circle cx="16" cy="8.2" r="1.45" class="fill-gold" />
    <circle cx="22.9" cy="12.2" r="1.45" class="fill-signal" />
    <circle cx="22.9" cy="19.8" r="1.45" class="fill-signal" />
    <circle cx="16" cy="23.8" r="1.45" class="fill-gold" />
    <circle cx="9.1" cy="19.8" r="1.45" class="fill-signal" />
    <circle cx="9.1" cy="12.2" r="1.45" class="fill-signal" />
  </svg>
  {
    wordmark && (
      <span class:list={['tracking-tight font-semibold', compact ? 'text-[1.05rem]' : 'text-lg']}>
        Lattix
      </span>
    )
  }
</a>
