---
import Logo from './Logo.astro';
import { products, markets, site } from '../data/site';
---

<footer class="bg-ink text-cream">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <Logo class="text-cream" />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-mist">
          The national lattice for health data. Labs, imaging, clinical records, and nationwide
          exchange — one connection, the complete patient story.
        </p>
        <a
          href={`mailto:${site.email}`}
          class="mt-5 inline-block text-sm text-signal hover:text-cream"
        >
          {site.email}
        </a>
      </div>
      <div>
        <p class="text-[0.7rem] font-medium uppercase tracking-[0.18em] text-gold">Product</p>
        <ul class="mt-4 space-y-2.5">
          {
            products.map((p) => (
              <li>
                <a href={p.href} class="text-sm text-mist transition hover:text-cream">
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="text-[0.7rem] font-medium uppercase tracking-[0.18em] text-gold">Markets</p>
        <ul class="mt-4 space-y-2.5">
          {
            markets.map((m) => (
              <li>
                <a href={m.href} class="text-sm text-mist transition hover:text-cream">
                  {m.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="text-[0.7rem] font-medium uppercase tracking-[0.18em] text-gold">Company</p>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/about" class="text-sm text-mist transition hover:text-cream">About</a></li>
          <li><a href="/security" class="text-sm text-mist transition hover:text-cream">Security</a></li>
          <li><a href="/developers" class="text-sm text-mist transition hover:text-cream">Developers</a></li>
          <li><a href="/contact" class="text-sm text-mist transition hover:text-cream">Contact</a></li>
          <li><a href="/privacy" class="text-sm text-mist transition hover:text-cream">Privacy</a></li>
          <li><a href="/terms" class="text-sm text-mist transition hover:text-cream">Terms</a></li>
        </ul>
      </div>
    </div>
    <div
      class="mt-14 flex flex-col gap-3 border-t border-white/8 pt-6 text-xs text-mist/80 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {new Date().getFullYear()} Lattix. All rights reserved.</p>
      <p>Built for TEFCA, state data exchange, and the complete clinical record.</p>
    </div>
  </div>
</footer>
