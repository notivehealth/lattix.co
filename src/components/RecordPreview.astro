---
const sections = [
  { k: 'Medications', v: 'Lisinopril 10mg · Metformin 500mg' },
  { k: 'Labs', v: 'HbA1c 6.4% · CMP within range' },
  { k: 'Imaging', v: 'Chest CT — no acute process' },
  { k: 'Allergies', v: 'Penicillin — rash' },
  { k: 'Immunizations', v: 'Influenza 2025 · COVID-19 bivalent' },
  { k: 'Encounters', v: 'ED — Memorial, 12 days ago' },
];
---

<div class="overflow-hidden rounded-2xl border border-white/10 bg-ink-2 shadow-2xl">
  <div class="flex items-center justify-between border-b border-white/8 px-5 py-3">
    <div class="flex items-center gap-2">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff6b6b]/80"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-gold/80"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-signal/80"></span>
    </div>
    <p class="font-mono text-[11px] tracking-wide text-mist">lattix.co / record</p>
  </div>
  <div class="grid gap-0 md:grid-cols-[200px_1fr]">
    <aside class="hidden border-r border-white/8 p-4 text-sm text-mist md:block">
      <p class="mb-3 text-[0.65rem] uppercase tracking-[0.16em] text-gold">Chart</p>
      <ul class="space-y-2">
        {['Summary', 'Problems', 'Meds', 'Labs', 'Imaging', 'Notes', 'Encounters'].map((item, i) => (
          <li class:list={['rounded-md px-2 py-1', i === 0 ? 'bg-white/8 text-cream' : '']}>{item}</li>
        ))}
      </ul>
    </aside>
    <div class="p-5 sm:p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-[0.65rem] uppercase tracking-[0.16em] text-gold">Longitudinal record</p>
          <h3 class="mt-1 font-serif text-2xl text-cream">Elena Voss</h3>
          <p class="mt-1 font-mono text-xs text-mist">54 F · MRN-88421 · matched 4 sources</p>
        </div>
        <span class="rounded-full bg-signal/15 px-3 py-1 text-xs font-medium text-signal">De-duplicated</span>
      </div>
      <dl class="mt-6 divide-y divide-white/8">
        {
          sections.map((s) => (
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between">
              <dt class="text-xs uppercase tracking-[0.14em] text-mist">{s.k}</dt>
              <dd class="text-sm text-cream/90">{s.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</div>
