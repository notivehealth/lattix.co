---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { products, markets, nav } from '../data/site';
---

<header
  class="sticky top-0 z-50 border-b border-white/8 bg-ink/92 text-cream backdrop-blur-xl"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-5 sm:px-8">
    <Logo class="text-cream" compact />

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      <div class="group relative">
        <button
          class="flex items-center gap-1.5 rounded-full px-3 py-2 text-sm text-cream/80 transition hover:text-cream"
          type="button"
        >
          Product
          <svg class="h-3.5 w-3.5 opacity-60" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
        </button>
        <div
          class="invisible absolute left-0 top-full z-50 w-[36rem] pt-3 opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
        >
          <div class="grid grid-cols-2 gap-1 rounded-2xl border border-white/10 bg-ink-2 p-3 shadow-2xl">
            {
              products.map((p) => (
                <a
                  href={p.href}
                  class="rounded-xl p-3 transition hover:bg-white/5"
                >
                  <div class="text-sm font-medium text-cream">{p.name}</div>
                  <p class="mt-1 text-xs leading-relaxed text-mist">{p.blurb}</p>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <div class="group relative">
        <button
          class="flex items-center gap-1.5 rounded-full px-3 py-2 text-sm text-cream/80 transition hover:text-cream"
          type="button"
        >
          Markets
          <svg class="h-3.5 w-3.5 opacity-60" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
        </button>
        <div
          class="invisible absolute left-0 top-full z-50 w-[22rem] pt-3 opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
        >
          <div class="flex flex-col gap-1 rounded-2xl border border-white/10 bg-ink-2 p-3 shadow-2xl">
            {
              markets.map((m) => (
                <a href={m.href} class="rounded-xl p-3 transition hover:bg-white/5">
                  <div class="text-sm font-medium text-cream">{m.name}</div>
                  <p class="mt-1 text-xs leading-relaxed text-mist">{m.blurb}</p>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      {
        nav.links.map((l) => (
          <a href={l.href} class="rounded-full px-3 py-2 text-sm text-cream/80 transition hover:text-cream">
            {l.name}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden sm:block">
        <Button href="/contact" variant="primary" size="sm">Talk to an expert</Button>
      </div>
      <button
        id="nav-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/12 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span class="sr-only">Menu</span>
        <svg id="nav-icon-open" class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 6h12M4 10h12M4 14h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
        <svg id="nav-icon-close" class="hidden h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-white/8 bg-ink lg:hidden" hidden>
    <nav class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-6 sm:px-8" aria-label="Mobile">
      <div>
        <p class="mb-2 text-[0.7rem] font-medium uppercase tracking-[0.18em] text-gold">Product</p>
        <div class="grid gap-1">
          {
            products.map((p) => (
              <a href={p.href} class="rounded-lg py-2 text-sm text-cream/90">
                {p.name}
              </a>
            ))
          }
        </div>
      </div>
      <div>
        <p class="mb-2 text-[0.7rem] font-medium uppercase tracking-[0.18em] text-gold">Markets</p>
        <div class="grid gap-1">
          {
            markets.map((m) => (
              <a href={m.href} class="rounded-lg py-2 text-sm text-cream/90">
                {m.name}
              </a>
            ))
          }
        </div>
      </div>
      <div class="grid gap-1">
        {
          nav.links.map((l) => (
            <a href={l.href} class="rounded-lg py-2 text-sm text-cream/90">
              {l.name}
            </a>
          ))
        }
      </div>
      <Button href="/contact" variant="primary" size="md" class="w-full">Talk to an expert</Button>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const openIcon = document.getElementById('nav-icon-open');
  const closeIcon = document.getElementById('nav-icon-close');

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    panel?.classList.toggle('hidden', open);
    if (panel) panel.hidden = open;
    openIcon?.classList.toggle('hidden', !open);
    closeIcon?.classList.toggle('hidden', open);
    document.body.classList.toggle('overflow-hidden', !open);
  });
</script>
