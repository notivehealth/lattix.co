---
const snippet = `const res = await fetch("https://api.lattix.co/fhir/Patient", {
  method: "GET",
  headers: {
    Authorization: "Bearer <token>",
    Accept: "application/fhir+json",
  },
});

const bundle = await res.json();
// Longitudinal, de-duplicated FHIR resources
console.log(bundle.entry.length);`;
---

<div class="overflow-hidden rounded-2xl border border-white/10 bg-[#0b1018] shadow-2xl">
  <div class="flex items-center justify-between border-b border-white/8 px-4 py-2.5">
    <div class="flex gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
    </div>
    <p class="font-mono text-[11px] text-mist">GET /fhir/Patient</p>
  </div>
  <pre class="overflow-x-auto p-5 text-[13px] leading-relaxed text-cream/90"><code>{snippet}</code></pre>
</div>
