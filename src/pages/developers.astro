---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CodeSample from '../components/CodeSample.astro';
import CTA from '../components/CTA.astro';
import Button from '../components/Button.astro';
---

<Base
  title="Developers"
  description="FHIR-native APIs for lab and imaging orders, structured results, and the clinical record. Sandbox, versioned changes, sample code."
>
  <PageHero
    eyebrow="Developers"
    title="The lattice, as an API"
    lede="Integrate Diagnostics and Clinical Record with FHIR REST APIs, a sandbox tenant, and production-shaped examples."
    primaryHref="/contact"
    primaryLabel="Request sandbox access"
    secondaryHref="#fhir"
    secondaryLabel="Example request"
  />

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            { t: 'FHIR REST APIs', d: 'Orders, results, and the chart payload — the lattice as versioned endpoints.' },
            { t: 'Sandbox', d: 'A non-production tenant for development and testing.' },
            { t: 'Sample code', d: 'Node and Python examples for the order and result paths.' },
            { t: 'Versioned changes', d: 'API changes ship with versions, not surprises.' },
            { t: 'Workflow diagrams', d: 'Order, result, file — documented as they run.' },
            { t: 'HL7 under the hood', d: 'Partners who still speak v2 do not force your product off FHIR.' },
          ].map((i) => (
            <article class="rounded-2xl border border-ink/8 bg-cream p-6">
              <h2 class="font-medium">{i.t}</h2>
              <p class="mt-2 text-sm text-ink/65">{i.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="fhir" class="bg-ink px-5 py-24 text-cream sm:px-8">
    <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-[0.75rem] font-medium uppercase tracking-[0.2em] text-gold">Example</p>
        <h2 class="mt-4 font-serif text-4xl tracking-tight">Place an order over FHIR</h2>
        <p class="mt-5 text-mist">
          Base URL <span class="font-mono text-signal">https://api.lattix.co/fhir</span>. OAuth 2.0
          bearer tokens. Resources you already know: Patient, ServiceRequest, Observation,
          DiagnosticReport, ImagingStudy, Subscription.
        </p>
        <p class="mt-4 text-sm text-mist">
          Legacy interop is handled under the hood: HL7 v2, SFTP, MLLP.
        </p>
        <div class="mt-8">
          <Button href="/contact" variant="primary">Get credentials</Button>
        </div>
      </div>
      <CodeSample />
    </div>
  </section>

  <section class="bg-cream px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">Common resources</h2>
      <div class="mt-10 overflow-hidden rounded-2xl border border-ink/8">
        <table class="w-full text-left text-sm">
          <thead class="bg-ink text-cream">
            <tr>
              <th class="px-5 py-3 font-medium">Resource</th>
              <th class="px-5 py-3 font-medium">Used for</th>
            </tr>
          </thead>
          <tbody class="bg-paper">
            {
              [
                ['Patient', 'Identity and match'],
                ['ServiceRequest', 'Lab and imaging orders'],
                ['DiagnosticReport / Observation', 'Structured results'],
                ['ImagingStudy', 'Imaging context alongside the report'],
                ['DocumentReference', 'Clinical documents on the payload'],
                ['Subscription', 'Result delivery when the lab files'],
              ].map(([r, u]) => (
                <tr class="border-t border-ink/8">
                  <td class="px-5 py-3 font-mono text-xs">{r}</td>
                  <td class="px-5 py-3 text-ink/70">{u}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CTA title="Request a sandbox tenant" />
</Base>
