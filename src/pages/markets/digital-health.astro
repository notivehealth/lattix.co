---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CodeSample from '../../components/CodeSample.astro';
import CTA from '../../components/CTA.astro';
import Trust from '../../components/Trust.astro';
import Button from '../../components/Button.astro';
---

<Base
  title="Digital health"
  description="Place lab and imaging orders and receive structured results inside your product. FHIR APIs, a sandbox, no six-month interface roadmap."
>
  <PageHero
    eyebrow="Markets · Digital health"
    title="Ship diagnostics without becoming an interoperability company"
    lede="Place orders, file results, and pull a FHIR chart payload — in weeks, not an integration roadmap."
    image="/images/hero-lattice.jpg"
  />

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">What product teams start with</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <article class="rounded-2xl border border-ink/8 bg-cream p-7">
          <h3 class="font-medium">Automate lab and imaging orders</h3>
          <p class="mt-3 text-sm text-ink/65">
            Virtual care still needs bloodwork and studies. Place the order and get a structured
            result without staffing an HL7 team.
          </p>
          <Button href="/products/diagnostics" variant="ghost" size="sm" class="mt-5">Diagnostics</Button>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-cream p-7">
          <h3 class="font-medium">A history before the visit</h3>
          <p class="mt-3 text-sm text-ink/65">
            Pull a de-duplicated FHIR payload from organizations on the lattice into the product
            you already sell.
          </p>
          <Button href="/products/clinical-record" variant="ghost" size="sm" class="mt-5">Clinical Record</Button>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-cream p-7">
          <h3 class="font-medium">Stay on the product</h3>
          <p class="mt-3 text-sm text-ink/65">
            Versioned FHIR APIs, a sandbox, and the transports handled under the hood. Your
            engineers stay on what makes you distinct.
          </p>
          <Button href="/developers" variant="ghost" size="sm" class="mt-5">Developers</Button>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-ink px-5 py-24 text-cream sm:px-8">
    <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-serif text-4xl tracking-tight">An API, not a science project</h2>
        <p class="mt-5 text-mist">
          ServiceRequest out. DiagnosticReport back. The same resources you already know.
        </p>
        <div class="mt-8">
          <Button href="/developers" variant="primary">Developer docs</Button>
        </div>
      </div>
      <CodeSample />
    </div>
  </section>

  <Trust />
  <CTA />
</Base>
