---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Stats from '../../components/Stats.astro';
import CTA from '../../components/CTA.astro';
import Trust from '../../components/Trust.astro';
import Button from '../../components/Button.astro';
---

<Base
  title="EHR interoperability"
  description="Enable providers to participate in nationwide TEFCA exchange. Embed Lattix clinical records, lab ordering, and alerts in your EHR."
>
  <PageHero
    eyebrow="Markets · EHRs"
    title="Participate in nationwide exchange without building a network"
    lede="Enable providers to join government-endorsed data exchange, maximize connectivity, and capture future incentives — while you stay focused on the EHR."
    image="/images/hero-lattice.jpg"
  />

  <section class="bg-ink px-5 py-16 text-cream sm:px-8">
    <div class="mx-auto max-w-7xl">
      <Stats
        dark
        items={[
          { value: '220M+', label: 'Patients' },
          { value: '120K+', label: 'Care sites' },
          { value: '120+', label: 'Lab & imaging vendors' },
          { value: '92%', label: 'U.S. coverage' },
        ]}
      />
    </div>
  </section>

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight sm:text-5xl">What EHRs start with</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <article class="rounded-2xl border border-ink/8 bg-cream p-7">
          <h3 class="font-medium">Govern your own HIN</h3>
          <p class="mt-3 text-sm text-ink/65">
            Deploy a data-sharing ecosystem on our master patient index and record locator. Scale
            connectivity without standing up interchange infrastructure.
          </p>
          <Button href="/platform" variant="ghost" size="sm" class="mt-5">Platform</Button>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-cream p-7">
          <h3 class="font-medium">TEFCA and state DxF</h3>
          <p class="mt-3 text-sm text-ink/65">
            Participate in nationwide TEFCA exchange and California’s Data Exchange Framework
            through Lattix. Maximize real-time retrieval for the providers you sell to.
          </p>
          <Button href="/products/network" variant="ghost" size="sm" class="mt-5">Network</Button>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-cream p-7">
          <h3 class="font-medium">Automate diagnostics</h3>
          <p class="mt-3 text-sm text-ink/65">
            Avoid costly lab-by-lab interfaces. Centralize diagnostic ordering with national labs
            and imaging centers, including the largest reference vendors.
          </p>
          <Button href="/products/diagnostics" variant="ghost" size="sm" class="mt-5">Diagnostics</Button>
        </article>
      </div>
    </div>
  </section>

  <Trust />
  <CTA title="Make your EHR more valuable" lede="Embed the lattice. Your customers get national records, labs, imaging, and alerts." />
</Base>
