---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Stats from '../../components/Stats.astro';
import CTA from '../../components/CTA.astro';
import Trust from '../../components/Trust.astro';
import Button from '../../components/Button.astro';

const steps = [
  {
    n: '01',
    title: 'Identify a patient',
    body: 'Submit demographics for one patient or a bulk order. Choose tests from the partner’s live compendium.',
  },
  {
    n: '02',
    title: 'Place an order',
    body: 'Route electronically to the laboratory or imaging center on the lattice — HL7, FHIR, or the transport they already run.',
  },
  {
    n: '03',
    title: 'Receive results',
    body: 'Structured results come back the other way and file into your own system, with provenance.',
  },
];

const uses = [
  { title: 'Cash-pay and direct care', body: 'Offer electronic labs and imaging without a five-figure start or a new interface project for every partner.' },
  { title: 'Virtual care', body: 'Place diagnostic orders and receive results for remote care and monitoring.' },
  { title: 'Independent labs', body: 'Take electronic orders from EHRs that will never staff a custom interface just for you.' },
];
---

<Base
  title="Diagnostics"
  description="Electronic lab and imaging orders and structured results through one Lattix interface. Connect diagnostic partners without a six-month project for each."
>
  <PageHero
    eyebrow="Diagnostics"
    title="Lab and imaging ordering on a single interface"
    lede="Send orders electronically to laboratories and imaging centers on the lattice and file structured results — without a six-month build for each partner."
    image="/images/lab.jpg"
    secondaryHref="/markets/labs"
    secondaryLabel="For diagnostic vendors"
  />

  <section class="bg-ink px-5 py-16 text-cream sm:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="mb-8 text-sm text-mist">FHIR and HL7 APIs · Electronic orders · Structured results · One onboarding</p>
      <Stats dark />
    </div>
  </section>

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="max-w-2xl font-serif text-4xl tracking-tight sm:text-5xl">Automate diagnostic ordering</h2>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        <article class="rounded-2xl border border-ink/8 bg-cream p-7">
          <h3 class="text-lg font-medium">Reach the partners you can actually join</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/65">
            Regional, specialty, and independent laboratories and imaging groups — the density
            outpatient care actually uses — on one API. National reference laboratories and imaging
            networks use the same interface as volume and diligence land.
          </p>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-cream p-7">
          <h3 class="text-lg font-medium">Stop paying the interface tax</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/65">
            Each new diagnostic partner should not be a quarter of engineering and a mailbox of
            sample messages. Connect once. Add partners on the lattice without starting over.
          </p>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-cream p-7">
          <h3 class="text-lg font-medium">File results, not faxes</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/65">
            Replace paper and fax with electronic orders and structured results, so the record in
            your system — not the inbox — is the source of truth.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-ink px-5 py-24 text-cream sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">Order tests. Get results.</h2>
      <p class="mt-4 max-w-2xl text-mist">
        Place orders and receive results through the same FHIR APIs you use for the rest of the lattice.
      </p>
      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {
          steps.map((s) => (
            <li class="rounded-2xl border border-white/10 bg-ink-2 p-7">
              <span class="font-mono text-xs text-signal">{s.n}</span>
              <h3 class="mt-3 text-lg font-medium">{s.title}</h3>
              <p class="mt-2 text-sm text-mist">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="relative overflow-hidden bg-cream px-5 py-24 sm:px-8">
    <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-serif text-4xl tracking-tight">Imaging on the same lattice</h2>
        <p class="mt-5 text-lg text-ink/70">
          Diagnostics is not only bloodwork. Order imaging, receive reports, and file them next to
          the lab data — one patient, one interchange, one integration.
        </p>
        <div class="mt-8">
          <Button href="/contact" variant="dark">Talk about imaging connectivity</Button>
        </div>
      </div>
      <img
        src="/images/imaging.jpg"
        alt="Radiology workspace"
        class="h-80 w-full rounded-3xl object-cover"
      />
    </div>
  </section>

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">Use cases</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {
          uses.map((u) => (
            <article class="rounded-2xl border border-ink/8 bg-cream p-6">
              <h3 class="font-medium">{u.title}</h3>
              <p class="mt-2 text-sm text-ink/65">{u.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Trust />
  <CTA />
</Base>
