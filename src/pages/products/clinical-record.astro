---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ExchangePreview from '../../components/ExchangePreview.astro';
import CTA from '../../components/CTA.astro';
import Trust from '../../components/Trust.astro';
import { dataTypes } from '../../data/site';

const uses = [
  { title: 'Outpatient care', body: 'File labs, imaging, and prior history into the chart the clinician already has open.' },
  { title: 'Virtual care', body: 'Collect a usable history before the visit — from the organizations on the lattice, not a fax pile.' },
  { title: 'Care coordination', body: 'Put medications, allergies, procedures, and recent encounters into the systems coordinators already run.' },
  { title: 'Specialty diagnostics', body: 'Interpret complex results against the rest of the record, not a single requisition.' },
  { title: 'Digital health', body: 'Ship clinical features on a FHIR payload instead of becoming an interoperability company.' },
  { title: 'Population workflows', body: 'The same interchange that files a result can assemble a history for the people you are already treating.' },
];
---

<Base
  title="Clinical Record"
  description="The chart as data. Lattix delivers a de-duplicated FHIR payload — labs, imaging, medications, notes — from organizations on the lattice into your systems."
>
  <PageHero
    eyebrow="Clinical Record"
    title="The chart, exchanged as data"
    lede="A de-duplicated FHIR record from the organizations on the lattice. Treatment purpose. Actionable payloads. No second login."
    image="/images/record-glow.jpg"
    secondaryHref="/developers"
    secondaryLabel="FHIR APIs"
  />

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-2">
      <div>
        <h2 class="font-serif text-4xl tracking-tight sm:text-5xl">A complete payload, not a portal</h2>
        <p class="mt-5 text-lg text-ink/70">
          Important clinical information is missing in nearly one in seven visits. Lattix matches
          the patient, assembles what the lattice holds, and returns a FHIR chart your systems can
          file, analyze, and act on.
        </p>
        <div class="mt-8 grid gap-5">
          <article>
            <h3 class="font-medium">File it where care happens</h3>
            <p class="mt-1 text-sm text-ink/65">A complete history in the EHR or product already in use — not a stack of faxes.</p>
          </article>
          <article>
            <h3 class="font-medium">Same interchange as diagnostics</h3>
            <p class="mt-1 text-sm text-ink/65">Orders, results, and the rest of the record share identity, translation, and audit.</p>
          </article>
          <article>
            <h3 class="font-medium">Provenance on every fact</h3>
            <p class="mt-1 text-sm text-ink/65">De-duplicated, coded, and traceable to the source organization on the lattice.</p>
          </article>
        </div>
      </div>
      <ExchangePreview />
    </div>
  </section>

  <section class="bg-cream px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">Data on the lattice</h2>
      <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
        {
          dataTypes.map((d) => (
            <li class="rounded-xl border border-ink/8 bg-paper px-4 py-3 text-sm">{d}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">Use cases</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          uses.map((u) => (
            <article class="rounded-2xl border border-ink/8 bg-cream p-6">
              <h3 class="font-medium">{u.title}</h3>
              <p class="mt-2 text-sm text-ink/65">{u.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Trust />
  <CTA />
</Base>
