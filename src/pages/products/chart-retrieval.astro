---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Stats from '../../components/Stats.astro';
import RecordPreview from '../../components/RecordPreview.astro';
import CTA from '../../components/CTA.astro';
import Trust from '../../components/Trust.astro';
import { dataTypes } from '../../data/site';
---

<Base
  title="Chart Retrieval"
  description="Electronic medical record retrieval for insurers. Underwriting, claims, and disability — a searchable, consolidated history from a national network."
>
  <PageHero
    eyebrow="Chart Retrieval"
    title="The fastest way for insurers to access organized medical data"
    lede="Real-time chart retrieval for swift, accurate underwriting and claims. Authorized, consented access to a national network of providers and EHRs."
    image="/images/record-glow.jpg"
  />

  <section class="bg-ink px-5 py-16 text-cream sm:px-8">
    <div class="mx-auto max-w-7xl">
      <Stats
        dark
        items={[
          { value: '300K+', label: 'Providers' },
          { value: '40K+', label: 'Care sites' },
          { value: '150+', label: 'Health systems' },
          { value: '80%', label: 'Records in a day or less' },
        ]}
      />
    </div>
  </section>

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-2">
      <div>
        <h2 class="font-serif text-4xl tracking-tight">A meaningful consumer view</h2>
        <p class="mt-5 text-lg text-ink/70">
          With authorization and consent, life and disability carriers retrieve electronic records
          from some of the largest provider organizations and EHR systems in the country. Lattix
          processes that data into an organized, searchable chart — compliance assured.
        </p>
        <ul class="mt-8 space-y-3 text-sm text-ink/75">
          <li class="flex gap-3"><span class="text-signal-2">→</span> Decrease manual processes and records chasing</li>
          <li class="flex gap-3"><span class="text-signal-2">→</span> Improve the applicant experience with faster offers</li>
          <li class="flex gap-3"><span class="text-signal-2">→</span> Skip complex integrations — sign and start the same day</li>
        </ul>
      </div>
      <RecordPreview />
    </div>
  </section>

  <section class="bg-cream px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">Consumer-level health data</h2>
      <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
        {
          dataTypes.map((d) => (
            <li class="rounded-xl border border-ink/8 bg-paper px-4 py-3 text-sm">{d}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">Use cases</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        <article class="rounded-2xl border border-ink/8 bg-cream p-6">
          <h3 class="font-medium">Underwriting</h3>
          <p class="mt-2 text-sm text-ink/65">Better-informed, faster policy offers with a consolidated medical history.</p>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-cream p-6">
          <h3 class="font-medium">Disability benefit resolution</h3>
          <p class="mt-2 text-sm text-ink/65">Evaluate complete past medical history to resolve income claims.</p>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-cream p-6">
          <h3 class="font-medium">Life settlements</h3>
          <p class="mt-2 text-sm text-ink/65">Improve life-expectancy calculations with the rest of the chart, not a subset.</p>
        </article>
      </div>
    </div>
  </section>

  <Trust />
  <CTA />
</Base>
