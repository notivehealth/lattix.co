---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import Trust from '../../components/Trust.astro';

const lifecycle = [
  { title: 'Enroll', body: 'Monitor a defined roster or your full tenant. Eligibility is evaluated when activity occurs — not retroactively.' },
  { title: 'Detect', body: 'Watch nationwide ADT events and document exchange across inpatient, ED, outpatient, and post-acute settings.' },
  { title: 'Infer', body: 'Turn documents and HL7 into encounter context: class, facility, timing, and the matched patient.' },
  { title: 'Deliver', body: 'FHIR Subscription, SFTP, email, or SMS. Idempotent identifiers so retries do not double-fire your workflows.' },
];
---

<Base
  title="Clinical Alerts"
  description="ADT and network-activity alerts from a nationwide lattice of hospitals and care sites. Know when enrolled patients are admitted, discharged, or active elsewhere."
>
  <PageHero
    eyebrow="Clinical Alerts"
    title="Awareness the moment anything happens"
    lede="Real-time admission, discharge, and transfer alerts from a nationwide hospital network — plus document-driven clinical alerts across settings you do not control."
    image="/images/network-city.jpg"
    secondaryHref="/markets/value-based-care"
    secondaryLabel="For value-based care"
  />

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-3xl text-lg leading-relaxed text-ink/75">
      <p>
        Studies have shown that a third of primary care physicians are never notified when their
        patients are admitted. Patients who do not receive follow-up within 30 days of discharge are
        far more likely to return. Lattix Alerts close that gap for payers, ACOs, and providers in
        value-based arrangements.
      </p>
    </div>
    <div class="mx-auto mt-14 grid max-w-7xl gap-5 md:grid-cols-2">
      <article class="rounded-2xl border border-ink/8 bg-cream p-8">
        <h2 class="font-serif text-2xl">ADT network</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink/65">
          Event-driven notifications whenever an enrolled patient is admitted, transferred, or
          discharged. Detailed HL7 ADT encounter data, configurable alerts, and insight into ED
          utilization and readmission risk.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-ink/75">
          <li>— Hospital ADT from a national lattice</li>
          <li>— Roster-based enrollment</li>
          <li>— Original HL7 available via FHIR</li>
        </ul>
      </article>
      <article class="rounded-2xl border border-ink/8 bg-cream p-8">
        <h2 class="font-serif text-2xl">Document-driven alerts</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink/65">
          Clinical Alerts watch network document exchange — not only the hospital feed. When
          qualifying activity is inferred, you get a notification and, where licensed, the source
          document on the chart.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-ink/75">
          <li>— Cross-setting visibility</li>
          <li>— Encounter inference from clinical documents</li>
          <li>— FHIR Subscription or SFTP delivery</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="bg-ink px-5 py-24 text-cream sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">How an alert is born</h2>
      <ol class="mt-12 grid gap-5 md:grid-cols-4">
        {
          lifecycle.map((s, i) => (
            <li>
              <span class="font-mono text-xs text-signal">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 text-lg font-medium">{s.title}</h3>
              <p class="mt-2 text-sm text-mist">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-cream px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">Built for transitions of care</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        <article class="rounded-2xl border border-ink/8 bg-paper p-6">
          <h3 class="font-medium">Care coordination</h3>
          <p class="mt-2 text-sm text-ink/65">Reach patients after discharge. Schedule follow-up before the 30-day window closes.</p>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-paper p-6">
          <h3 class="font-medium">High-risk monitoring</h3>
          <p class="mt-2 text-sm text-ink/65">Enroll the populations you are accountable for and hear about activity wherever it happens.</p>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-paper p-6">
          <h3 class="font-medium">Value-based contracts</h3>
          <p class="mt-2 text-sm text-ink/65">Pair alerts with the complete record to understand the journey, not only the event.</p>
        </article>
      </div>
    </div>
  </section>

  <Trust />
  <CTA />
</Base>
