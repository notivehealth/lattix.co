---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Stats from '../../components/Stats.astro';
import CTA from '../../components/CTA.astro';
import Trust from '../../components/Trust.astro';
---

<Base
  title="Network"
  description="Participate in TEFCA and state data exchange through Lattix. A national health information network for treatment, payment, operations, and Individual Access."
>
  <PageHero
    eyebrow="Network"
    title="Nationwide exchange, one connection"
    lede="Join a secure, federally endorsed framework. Participate in TEFCA and state data-sharing — including California’s Data Exchange Framework — without standing up a network of your own."
    image="/images/network-city.jpg"
    secondaryHref="/security"
    secondaryLabel="Security & compliance"
  />

  <section class="bg-ink px-5 py-16 text-cream sm:px-8">
    <div class="mx-auto max-w-7xl">
      <Stats dark />
    </div>
  </section>

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="max-w-3xl font-serif text-4xl tracking-tight sm:text-5xl">
        Built for TEFCA, state DxF, and the private sector in between
      </h2>
      <p class="mt-6 max-w-2xl text-lg text-ink/70">
        Government-endorsed exchange is the floor, not the product. Lattix adds identity resolution,
        normalization, diagnostic ordering, alerts, and a chart on top of the pipes.
      </p>
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        <article class="rounded-2xl border border-ink/8 bg-cream p-8">
          <h3 class="text-lg font-medium">TEFCA participation</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/65">
            Exchange for treatment, Individual Access, payment, and additional purposes as they come
            online. Early alignment positions your organization for future federal incentives.
          </p>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-cream p-8">
          <h3 class="text-lg font-medium">State data exchange</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/65">
            Meet California DxF and other state frameworks through the same lattice you use for
            national query. One technical integration, many policy surfaces.
          </p>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-cream p-8">
          <h3 class="text-lg font-medium">Govern your own HIN</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/65">
            EHRs and health systems can scale a data-sharing ecosystem on top of our MPI and record
            locator — without becoming a network operator.
          </p>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-cream p-8">
          <h3 class="text-lg font-medium">Seamless growth</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/65">
            Connect once. As TEFCA and state networks expand, your queries reach further without a
            new project for every additional organization.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-cream px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">Purposes of use</h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        {
          [
            { t: 'Treatment', d: 'Retrieve records for patients you are treating.' },
            { t: 'Patient Access', d: 'Individual Access Services with verified identity.' },
            { t: 'Payment & operations', d: 'Authorized exchange for coverage, quality, and care management.' },
          ].map((p) => (
            <article class="rounded-2xl border border-ink/8 bg-paper p-6">
              <h3 class="font-medium">{p.t}</h3>
              <p class="mt-2 text-sm text-ink/65">{p.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Trust />
  <CTA />
</Base>
