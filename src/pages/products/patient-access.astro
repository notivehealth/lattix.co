---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Stats from '../../components/Stats.astro';
import CTA from '../../components/CTA.astro';
import Trust from '../../components/Trust.astro';

const steps = [
  {
    title: 'Add a patient',
    body: 'Capture demographics and a contact path so Lattix can invite the individual to retrieve their records.',
  },
  {
    title: 'Prove identity',
    body: 'The patient completes IAL2-compliant identity verification — a government ID and a live match — or supplies portal credentials for additional sources.',
  },
  {
    title: 'Share with you',
    body: 'Patient-mediated access lands a comprehensive record with the sponsoring organization, under Individual Access.',
  },
];

const uses = [
  { title: 'Prior authorization', body: 'Faster, better-informed PA decisions — less burden for payers and providers.' },
  { title: 'Clinical trial enrollment', body: 'Historical data without a scavenger hunt through faxes and portals.' },
  { title: 'New member intake', body: 'Consent-based medical histories at enrollment, not months later.' },
  { title: 'Evidence generation', body: 'Real-world data to support effectiveness of a product or treatment.' },
  { title: 'Drug research', body: 'See how patient subgroups respond when you finally have the rest of the chart.' },
  { title: 'Release of information', body: 'Let motivated patients share their information with you, securely.' },
];
---

<Base
  title="Patient Access"
  description="Enable Individual Access Services on the Lattix network. IAL2 identity, patient-mediated record retrieval, FHIR APIs, iframe, or SDK."
>
  <PageHero
    eyebrow="Patient Access"
    title="Patients retrieve and share their own records"
    lede="A seamless way to submit Individual Access queries across the national lattice. Customizable FHIR APIs, IAL2 identity verification, and secure sharing with the sponsoring organization."
    image="/images/record-glow.jpg"
  />

  <section class="bg-ink px-5 py-16 text-cream sm:px-8">
    <div class="mx-auto max-w-7xl">
      <Stats
        dark
        items={[
          { value: '220M+', label: 'Patients' },
          { value: '750K+', label: 'Clinicians' },
          { value: 'IAS', label: 'Purpose of use' },
          { value: 'IAL2', label: 'Identity verification' },
        ]}
      />
    </div>
  </section>

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight sm:text-5xl">Individual Access is here</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <article class="rounded-2xl border border-ink/8 bg-cream p-7">
          <h3 class="font-medium">Participate in designated exchange</h3>
          <p class="mt-2 text-sm text-ink/65">
            Maximize IAS responses by querying the Lattix network under Individual Access — including
            TEFCA and state framework participation.
          </p>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-cream p-7">
          <h3 class="font-medium">Skip the build</h3>
          <p class="mt-2 text-sm text-ink/65">
            Plug-and-play via API, iframe, or SDK. You should not have to become an identity and
            consent company to honor a patient’s right of access.
          </p>
        </article>
        <article class="rounded-2xl border border-ink/8 bg-cream p-7">
          <h3 class="font-medium">Access comprehensive data</h3>
          <p class="mt-2 text-sm text-ink/65">
            Patient-authorized retrieval is the most efficient, compliant way to gather a history
            when treatment purpose does not apply.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-ink px-5 py-24 text-cream sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">How it works</h2>
      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="rounded-2xl border border-white/10 bg-ink-2 p-7">
              <span class="font-mono text-xs text-signal">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 text-lg font-medium">{s.title}</h3>
              <p class="mt-2 text-sm text-mist">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-cream px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">Use cases</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          uses.map((u) => (
            <article class="rounded-2xl border border-ink/8 bg-paper p-6">
              <h3 class="font-medium">{u.title}</h3>
              <p class="mt-2 text-sm text-ink/65">{u.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Trust />
  <CTA />
</Base>
