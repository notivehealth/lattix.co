---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import Trust from '../components/Trust.astro';
import { products } from '../data/site';

const features = [
  {
    title: 'Partner connectivity',
    body: 'HL7 v2, FHIR, SFTP, and MLLP — the transports diagnostic partners and EHRs already run. One onboarding, not a custom project for every new logo.',
  },
  {
    title: 'Identity',
    body: 'Match the person across systems when names, MRNs, and birthdates never quite agree. Heuristic matching on demographics, not a hope that everyone uses the same identifier.',
  },
  {
    title: 'Translation',
    body: 'Vendor catalogs, local codes, and message flavors become one FHIR record. Orders go out in the shape the lab expects. Results come back structured.',
  },
  {
    title: 'Routing',
    body: 'Send the order to the right laboratory or imaging center, with the compendium, ABN, and billing context that partner requires.',
  },
  {
    title: 'Delivery',
    body: 'Push or pull the payload into the EHR or product already in use — FHIR REST, subscriptions, or files — with provenance on every fact.',
  },
  {
    title: 'FHIR REST APIs',
    body: 'ServiceRequest, DiagnosticReport, Observation, ImagingStudy, Patient. Legacy interop sits under the hood so product teams stay on FHIR.',
  },
];
---

<Base
  title="Platform"
  description="The Lattix interchange platform: connectivity, identity, translation, routing, delivery, and FHIR APIs for labs, imaging, and the clinical record."
>
  <PageHero
    eyebrow="Platform"
    title="The operated pipeline under every connection"
    lede="Organizations need more than a VPN and a spec. They need orders to land, results to file, and the next partner to reuse the same integration."
    image="/images/lattice-close.jpg"
    secondaryHref="/developers"
    secondaryLabel="API reference"
  />

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="text-lg leading-relaxed text-ink/75">
        Unreliable identifiers, one-off interfaces, and a different flavor of HL7 at every lab still
        leave outpatient care disconnected. The Lattix platform was built to connect, translate, and
        deliver — so EHRs, labs, imaging groups, and digital health teams make the next order in
        their own systems, not in a shared mailbox.
      </p>
    </div>
  </section>

  <section class="bg-cream px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight sm:text-5xl">Primary capabilities</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => (
            <article class="rounded-2xl border border-ink/8 bg-paper p-7">
              <h3 class="text-lg font-medium tracking-tight">{f.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink/65">{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">Products on the platform</h2>
      <p class="mt-4 max-w-2xl text-ink/70">
        Every Lattix product sits on the same lattice: connect, translate, route, and deliver.
      </p>
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          products
            .filter((p) => p.slug !== 'platform')
            .map((p) => (
              <a href={p.href} class="rounded-2xl border border-ink/8 bg-cream p-6 hover:border-signal/40">
                <h3 class="font-medium">{p.name}</h3>
                <p class="mt-2 text-sm text-ink/65">{p.blurb}</p>
              </a>
            ))
        }
      </div>
    </div>
  </section>

  <Trust />
  <CTA />
</Base>
