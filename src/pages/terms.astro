---
import Base from '../layouts/Base.astro';
---

<Base title="Terms" description="Terms of use for lattix.co.">
  <section class="bg-ink px-5 py-20 text-cream sm:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="text-[0.75rem] uppercase tracking-[0.2em] text-gold">Legal</p>
      <h1 class="mt-4 font-serif text-5xl tracking-tight">Terms of use</h1>
      <p class="mt-4 text-mist">Last updated August 29, 2026</p>
    </div>
  </section>
  <section class="prose-lattix bg-paper px-5 py-16 sm:px-8">
    <div class="mx-auto max-w-3xl space-y-8 text-[0.95rem] leading-relaxed text-ink/80">
      <p>
        These terms govern use of the Lattix marketing website at lattix.co. Platform services are
        governed by a separate customer agreement and Business Associate Agreement. This page is a
        working draft we will refine with counsel.
      </p>
      <div>
        <h2 class="font-serif text-2xl text-ink">The site</h2>
        <p class="mt-3">
          Content on this site is for information. It is not medical advice, and product descriptions
          will change. We may update pages without notice. Do not rely on this site as a
          specification.
        </p>
      </div>
      <div>
        <h2 class="font-serif text-2xl text-ink">Acceptable use</h2>
        <p class="mt-3">
          Do not misuse the site: no scraping that degrades service, no attempts to access
          non-public systems, no unlawful content in forms. We may block access that threatens the
          site or our users.
        </p>
      </div>
      <div>
        <h2 class="font-serif text-2xl text-ink">Intellectual property</h2>
        <p class="mt-3">
          Lattix names, marks, and site content are owned by Lattix or its licensors. You may not
          use them except as needed to use the site, or with written permission.
        </p>
      </div>
      <div>
        <h2 class="font-serif text-2xl text-ink">Disclaimers</h2>
        <p class="mt-3">
          The site is provided “as is.” To the fullest extent permitted by law we disclaim warranties
          and limit liability for damages arising from use of the marketing site.
        </p>
      </div>
      <div>
        <h2 class="font-serif text-2xl text-ink">Contact</h2>
        <p class="mt-3">Questions: use the <a href="/contact">contact form</a>.</p>
      </div>
    </div>
  </section>
</Base>
