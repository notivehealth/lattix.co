---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';

const values = [
  {
    title: 'Precision',
    body: 'Matching, translation, and routing are the product. Close enough is how the wrong lab gets the order.',
  },
  {
    title: 'Stewardship',
    body: 'Health data is not a growth hack. We take the minimum permitted access and leave an audit trail.',
  },
  {
    title: 'Interconnect',
    body: 'A lattice only works if every node can find the others. We would rather connect a competitor’s lab than leave a clinic on fax.',
  },
];

const timeline = [
  {
    y: 'Interfaces',
    d: 'Years of shipping healthcare interfaces — labs, imaging, e-prescribing rails, the unglamorous HL7 that actually moves an order.',
  },
  {
    y: 'Production EHR',
    d: 'Ran that stack in outpatient care. Watched clinics wait on national projects they could not qualify for, and independent labs lose the order.',
  },
  {
    y: 'The lattice',
    d: 'Productized the interchange: one connection, orders and results, a FHIR payload instead of a mailbox of sample messages.',
  },
  {
    y: 'What compounds',
    d: 'Regional and specialty partners first. National networks on the same pipes when volume and diligence land. The brand and the coverage arrive together.',
  },
];
---

<Base
  title="About"
  description="Lattix is the lattice for health data interchange — labs, imaging, and the clinical record — built by people who have shipped healthcare interfaces and still run them in production."
>
  <PageHero
    eyebrow="About Lattix"
    title="The interchange we were tired of not having"
    lede="It is a jungle out there in health information technology. Lattix is the lattice that holds the nodes together."
    image="/images/lattice-close.jpg"
    primaryHref="/contact"
    primaryLabel="Contact us"
  />

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-3xl text-lg leading-relaxed text-ink/75">
      <p>
        A lattice is a structure of repeating connections. That is the job: not a single heroic
        interface, but a network dense enough that an order can leave an EHR, land at a laboratory
        or imaging center, and come back as a structured result — and that the next partner reuses
        the same pipes.
      </p>
      <p class="mt-6">
        Lattix comes from people who have built those interfaces for years and still operate them
        in cash-pay and direct-care practice. We got tired of watching those clinics wait on a
        national project they could not qualify for, and watching independent labs lose work
        because nobody would staff the connection. The interchange is now its own product.
      </p>
    </div>
  </section>

  <section class="bg-cream px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">How we got here</h2>
      <ol class="mt-12 grid gap-5 md:grid-cols-2">
        {
          timeline.map((t) => (
            <li class="rounded-2xl border border-ink/8 bg-paper p-7">
              <p class="text-[0.7rem] uppercase tracking-[0.16em] text-gold">{t.y}</p>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">{t.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="font-serif text-4xl tracking-tight">Company values</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          values.map((v) => (
            <article class="rounded-2xl border border-ink/8 bg-cream p-7">
              <h3 class="font-medium">{v.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink/65">{v.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTA title="Work with us" lede="Labs, imaging groups, EHR teams, interoperability people — we would like to hear from you." />
</Base>
