---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Stats from '../components/Stats.astro';
import RecordPreview from '../components/RecordPreview.astro';
import CodeSample from '../components/CodeSample.astro';
import CTA from '../components/CTA.astro';
import Trust from '../components/Trust.astro';
import { markets, pipeline, products, site } from '../data/site';
---

<Base title={undefined} description={site.description}>
  <section class="relative overflow-hidden bg-ink text-cream">
    <img
      src="/images/hero-lattice.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-50"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/30 via-ink/55 to-ink"></div>
    <div class="relative mx-auto max-w-7xl px-5 pb-24 pt-20 sm:px-8 sm:pt-28 lg:pb-32 lg:pt-36">
      <p class="mb-6 text-[0.75rem] font-medium uppercase tracking-[0.22em] text-gold">
        Health data interchange
      </p>
      <h1 class="max-w-4xl font-serif text-5xl leading-[1.08] tracking-tight text-balance sm:text-7xl">
        Every patient record, on one lattice.
      </h1>
      <p class="mt-7 max-w-2xl text-lg text-mist text-pretty sm:text-xl">
        Lattix is the national interchange for labs, imaging, and the complete clinical record.
        FHIR-native APIs. Nationwide exchange. Built for TEFCA and state data-sharing frameworks.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <Button href="/contact" variant="primary" size="lg">Talk to an expert</Button>
        <Button href="/platform" variant="secondary" size="lg">Explore the platform</Button>
      </div>
      <div class="mt-16 max-w-4xl border-t border-white/10 pt-10">
        <Stats dark />
      </div>
    </div>
  </section>

  <section class="bg-paper px-5 py-20 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="text-center text-[0.75rem] font-medium uppercase tracking-[0.2em] text-gold">
        Trusted by leaders in healthcare
      </p>
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {
          ['Northstar Health', 'Helix EHR', 'Summit Payor', 'Viridian Care'].map((name) => (
            <div class="flex h-16 items-center justify-center rounded-xl border border-ink/8 bg-cream text-sm font-medium tracking-tight text-ink/50">
              {name}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-cream px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-2xl">
        <p class="text-[0.75rem] font-medium uppercase tracking-[0.2em] text-gold">The value we add</p>
        <h2 class="mt-4 font-serif text-4xl tracking-tight text-balance sm:text-5xl">
          Not just the data. The operated pipeline.
        </h2>
        <p class="mt-5 text-lg text-ink/70 text-pretty">
          Our value is not “we have the data.” It is the pipeline that turns fragmented, duplicated,
          multi-source records into one trustworthy chart.
        </p>
      </div>
      <ol class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          pipeline.map((step) => (
            <li class="rounded-2xl border border-ink/8 bg-paper p-6">
              <span class="font-mono text-xs text-signal-2">{step.n}</span>
              <h3 class="mt-3 text-lg font-medium tracking-tight">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/65">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-10 max-w-2xl text-ink/70">
        And the moment something changes:{' '}
        <a href="/products/alerts" class="font-medium text-ink underline decoration-signal underline-offset-4">
          Clinical Alerts
        </a>
        {' '}listen across network activity, not just the hospital in front of you.
      </p>
    </div>
  </section>

  <section class="bg-ink px-5 py-24 text-cream sm:px-8">
    <div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="text-[0.75rem] font-medium uppercase tracking-[0.2em] text-gold">Clinical Record</p>
        <h2 class="mt-4 font-serif text-4xl tracking-tight text-balance sm:text-5xl">
          The patient’s whole story, assembled.
        </h2>
        <p class="mt-5 text-lg text-mist text-pretty">
          Important clinical information is missing in nearly one in seven visits. Lattix retrieves,
          matches, and normalizes records from nationwide EHRs so care teams see medications, labs,
          imaging, notes, and encounters in one place.
        </p>
        <ul class="mt-8 space-y-3 text-sm text-cream/85">
          <li class="flex gap-3"><span class="text-signal">→</span> Master Patient Index with heuristic matching</li>
          <li class="flex gap-3"><span class="text-signal">→</span> Record locator across care sites you did not know to query</li>
          <li class="flex gap-3"><span class="text-signal">→</span> FHIR resources plus C-CDA, HL7, X12, and Direct</li>
        </ul>
        <div class="mt-8">
          <Button href="/products/clinical-record" variant="primary">See Clinical Record</Button>
        </div>
      </div>
      <RecordPreview />
    </div>
  </section>

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="text-[0.75rem] font-medium uppercase tracking-[0.2em] text-gold">Diagnostics</p>
          <h2 class="mt-4 font-serif text-4xl tracking-tight text-balance sm:text-5xl">
            Labs and imaging, one interface.
          </h2>
          <p class="mt-5 text-lg text-ink/70 text-pretty">
            Send lab and imaging orders electronically to any connected diagnostic vendor and receive
            structured results — without a six-month integration for each lab.
          </p>
        </div>
        <Button href="/products/diagnostics" variant="ghost">Explore Diagnostics</Button>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <article class="relative overflow-hidden rounded-3xl">
          <img src="/images/lab.jpg" alt="Clinical laboratory analyzer and specimen racks" class="h-80 w-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-7 text-cream">
            <h3 class="font-serif text-2xl">Laboratory network</h3>
            <p class="mt-2 max-w-md text-sm text-mist">
              National reference labs, health-system labs, regional and specialty vendors. 6,200+
              patient service centers. More than 90% of the U.S. lives within 20 miles of one.
            </p>
          </div>
        </article>
        <article class="relative overflow-hidden rounded-3xl">
          <img src="/images/imaging.jpg" alt="Radiology suite with glowing diagnostic displays" class="h-80 w-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-7 text-cream">
            <h3 class="font-serif text-2xl">Imaging exchange</h3>
            <p class="mt-2 max-w-md text-sm text-mist">
              Electronic imaging orders and results alongside the lab workflow. Radiology, cardiology,
              and specialty studies in the same interchange.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-cream px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="text-[0.75rem] font-medium uppercase tracking-[0.2em] text-gold">Who we serve</p>
      <h2 class="mt-4 max-w-2xl font-serif text-4xl tracking-tight text-balance sm:text-5xl">
        A complete, trustworthy record. You do not have to build any of it.
      </h2>
      <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          markets.map((m) => (
            <a
              href={m.href}
              class="group rounded-2xl border border-ink/8 bg-paper p-7 transition hover:border-signal/50 hover:shadow-[0_20px_50px_-30px_rgb(8_12_20_/_0.4)]"
            >
              <h3 class="text-lg font-medium tracking-tight group-hover:text-signal-2">{m.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/65">{m.blurb}</p>
              <p class="mt-5 text-xs uppercase tracking-[0.14em] text-gold">Starts with</p>
              <p class="mt-1 text-sm text-ink/80">{m.startsWith}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-ink px-5 py-24 text-cream sm:px-8">
    <img src="/images/network-city.jpg" alt="" class="absolute inset-0 h-full w-full object-cover opacity-30" />
    <div class="absolute inset-0 bg-ink/70"></div>
    <div class="relative mx-auto max-w-7xl">
      <p class="text-[0.75rem] font-medium uppercase tracking-[0.2em] text-gold">Nationwide network</p>
      <h2 class="mt-4 max-w-3xl font-serif text-4xl tracking-tight text-balance sm:text-5xl">
        Universal data access. Compliant at our core.
      </h2>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <a href="/products/network" class="rounded-2xl border border-white/10 bg-ink/60 p-7 backdrop-blur">
          <h3 class="text-lg font-medium">Government frameworks</h3>
          <p class="mt-2 text-sm leading-relaxed text-mist">
            Participate in TEFCA and state data exchange — including California’s DxF — through a
            single Lattix connection.
          </p>
        </a>
        <a href="/security" class="rounded-2xl border border-white/10 bg-ink/60 p-7 backdrop-blur">
          <h3 class="text-lg font-medium">Powerful security</h3>
          <p class="mt-2 text-sm leading-relaxed text-mist">
            HITRUST R2, SOC 2 Type II, and HIPAA. Encryption, audit, retention, and governance
            designed for permitted health data.
          </p>
        </a>
        <a href="/about" class="rounded-2xl border border-white/10 bg-ink/60 p-7 backdrop-blur">
          <h3 class="text-lg font-medium">Interoperability, operated</h3>
          <p class="mt-2 text-sm leading-relaxed text-mist">
            We run the matching, translation, and delivery so your team can stay on product, care,
            and coverage — not interfaces.
          </p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-paper px-5 py-24 sm:px-8">
    <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-[0.75rem] font-medium uppercase tracking-[0.2em] text-gold">Designed for developers</p>
        <h2 class="mt-4 font-serif text-4xl tracking-tight sm:text-5xl">FHIR-native. Production-ready.</h2>
        <p class="mt-5 text-lg text-ink/70">
          Integrate the lattice into your EHR, digital health app, or payer platform with versioned
          APIs, a sandbox, and the same resources you already know.
        </p>
        <ul class="mt-6 grid gap-2 text-sm text-ink/75 sm:grid-cols-2">
          {
            ['Software + API', 'Sandbox tenant', 'Sample code', 'Workflow diagrams', 'Versioned changes', 'Metadata support'].map(
              (item) => (
                <li class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-signal-2" />
                  {item}
                </li>
              ),
            )
          }
        </ul>
        <div class="mt-8">
          <Button href="/developers" variant="dark">Open developer docs</Button>
        </div>
      </div>
      <CodeSample />
    </div>
  </section>

  <section class="bg-cream px-5 py-20 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="text-[0.75rem] font-medium uppercase tracking-[0.2em] text-gold">The product suite</p>
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          products.map((p) => (
            <a href={p.href} class="rounded-2xl border border-ink/8 bg-paper p-6 transition hover:border-signal/40">
              <h3 class="font-medium tracking-tight">{p.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/65">{p.blurb}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Trust />
  <CTA />
</Base>
